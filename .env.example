# Domeggook → SmartStore MVP local environment example
# Copy to .env only when local overrides are needed.
# Do not commit real .env files.

# Frontend → backend URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional browser harness executable for SmartStore seller-center preview automation.
# Leave empty if you only use the analyzer/package builder.
BROWSER_HARNESS_WIN_BIN=

# Optional Chrome DevTools Protocol endpoint.
# Default in code: http://127.0.0.1:9223
BU_CDP_URL=http://127.0.0.1:9223
